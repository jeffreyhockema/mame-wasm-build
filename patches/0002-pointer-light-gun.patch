+//============================================================
+//  sdl_lightgun_device
+//============================================================
+
+// The pointer as a light gun: where it is in the window is where the gun aims, and its buttons
+// are the gun's (a touch screen's taps arrive as the left button). After the
+// sdl_lightgun_device of later MAME versions, for the browser build, where SDL has no gun.
+class sdl_lightgun_device : public sdl_device
+{
+public:
+	struct lightgun_state
+	{
+		int32_t lX, lY;
+		int32_t buttons[MAX_BUTTONS];
+	};
+
+	lightgun_state lightgun;
+
+	sdl_lightgun_device(running_machine &machine, std::string &&name, std::string &&id, input_module &module) :
+		sdl_device(machine, std::move(name), std::move(id), DEVICE_CLASS_LIGHTGUN, module),
+		lightgun({0}),
+		m_x(0),
+		m_y(0),
+		m_window(0)
+	{
+	}
+
+	void reset() override
+	{
+		memset(&lightgun, 0, sizeof(lightgun));
+		m_x = m_y = 0;
+		m_window = 0;
+	}
+
+	void poll() override
+	{
+		sdl_device::poll();
+
+		SDL_Window *const win(m_window ? SDL_GetWindowFromID(m_window) : nullptr);
+		if (win)
+		{
+			int w, h;
+			SDL_GetWindowSize(win, &w, &h);
+			lightgun.lX = normalize_absolute_axis(m_x, 0, w - 1);
+			lightgun.lY = normalize_absolute_axis(m_y, 0, h - 1);
+		}
+	}
+
+	virtual void process_event(SDL_Event &sdlevent) override
+	{
+		switch (sdlevent.type)
+		{
+		case SDL_MOUSEMOTION:
+			m_x = sdlevent.motion.x;
+			m_y = sdlevent.motion.y;
+			m_window = sdlevent.motion.windowID;
+			break;
+
+		case SDL_MOUSEBUTTONDOWN:
+		case SDL_MOUSEBUTTONUP:
+			if (sdlevent.button.button >= 1 && sdlevent.button.button <= MAX_BUTTONS)
+				lightgun.buttons[sdlevent.button.button - 1] = (sdlevent.type == SDL_MOUSEBUTTONDOWN) ? 0x80 : 0;
+			m_x = sdlevent.button.x;
+			m_y = sdlevent.button.y;
+			m_window = sdlevent.button.windowID;
+			break;
+		}
+	}
+
+private:
+	int32_t m_x, m_y;
+	uint32_t m_window;
+};
