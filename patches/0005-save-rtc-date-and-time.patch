--- a/src/emu/dirtc.cpp
+++ b/src/emu/dirtc.cpp
@@ -43,6 +43,21 @@ device_rtc_interface::~device_rtc_interface()
 }
 
 
+//-------------------------------------------------
+//  interface_pre_start - the date and time go in
+//  save states: the device's own registers are
+//  set from them each second, so a state loaded
+//  without them parts from the machine it was
+//  saved on (under a name of its own, in case a
+//  device saves the array itself)
+//-------------------------------------------------
+
+void device_rtc_interface::interface_pre_start()
+{
+	device().save_item(m_register, "rtc_register");
+}
+
+
