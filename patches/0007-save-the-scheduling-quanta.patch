 void device_scheduler::presave()
 {
+	// pack the live scheduling quanta into the state (see the note in schedule.h)
+	m_saved_quantum_count = 0;
+	for (quantum_slot *quant = m_quantum_list.first(); quant != nullptr; quant = quant->next())
+	{
+		if (m_saved_quantum_count >= SAVED_QUANTA)
+			break;
+		const u32 index = m_saved_quantum_count++;
+		m_saved_quantum_actual[index] = quant->m_actual;
+		m_saved_quantum_requested[index] = quant->m_requested;
+		m_saved_quantum_expire_secs[index] = quant->m_expire.seconds();
+		m_saved_quantum_expire_attos[index] = quant->m_expire.attoseconds();
+	}
+
 	// report the timer state after a log
 	LOG("Prior to saving state:\n");
 #if VERBOSE
@@ -698,6 +723,19 @@
 	while ((timer = private_list.detach_head()) != nullptr)
 		timer_list_insert(*timer);
 
+	// put the scheduling quanta back as they were when the state was taken, in the order
+	// add_scheduling_quantum keeps them in (shortest asked-for first)
+	while (m_quantum_list.first() != nullptr)
+		m_quantum_allocator.reclaim(m_quantum_list.detach_head());
+	for (u32 index = 0; index < m_saved_quantum_count && index < SAVED_QUANTA; index++)
+	{
+		quantum_slot &quant = *m_quantum_allocator.alloc();
+		quant.m_actual = m_saved_quantum_actual[index];
+		quant.m_requested = m_saved_quantum_requested[index];
+		quant.m_expire = attotime(m_saved_quantum_expire_secs[index], m_saved_quantum_expire_attos[index]);
+		m_quantum_list.append(quant);
+	}
+
 	m_suspend_changes_pending = true;
 	rebuild_execute_list();
 
