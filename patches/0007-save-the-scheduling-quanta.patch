 	simple_list<quantum_slot>   m_quantum_list;             // list of active quanta
 	fixed_allocator<quantum_slot> m_quantum_allocator;      // allocator for quanta
 	attoseconds_t               m_quantum_minimum;          // duration of minimum quantum
+
+	// The quanta a driver asks for decide where a timeslice ends, and so how a board's CPUs
+	// interleave, but they were never part of a save state: a machine that loaded one went on
+	// cutting its timeslices the way the machine it was loaded into had been. Two copies of a
+	// game kept in step by rollback part within a frame or two of a load because of it. These
+	// hold the live list while it is written out and read back (see presave and postload).
+	static constexpr int SAVED_QUANTA = 8;
+	u32                         m_saved_quantum_count;
+	s64                         m_saved_quantum_actual[SAVED_QUANTA];
+	s64                         m_saved_quantum_requested[SAVED_QUANTA];
+	s64                         m_saved_quantum_expire_secs[SAVED_QUANTA];
+	s64                         m_saved_quantum_expire_attos[SAVED_QUANTA];
 };
 
 
