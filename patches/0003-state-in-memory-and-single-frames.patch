+// Rollback netplay (a page runs frames itself, keeps the machine's state after each, and goes
+// back to one to run again with a late press): the state in memory, as MAME's rewind keeps it.
+
+int running_machine::emscripten_state_size() {
+	running_machine *const machine = emscripten_running_machine;
+	if (!machine)
+		return -1;
+	std::ostringstream str;
+	if (machine->m_save.write_stream(str) != STATERR_NONE)
+		return -1;
+	return int(str.tellp());
+}
+
+// 0 when saved; -2 while anonymous timers make it unsafe (as handle_saveload waits for)
+int running_machine::emscripten_state_save(void *buf, int size) {
+	running_machine *const machine = emscripten_running_machine;
+	if (!machine)
+		return -1;
+	if (!machine->m_scheduler.can_save())
+		return -2;
+	return int(machine->m_save.write_buffer(buf, size_t(size)));
+}
+
+int running_machine::emscripten_state_load(const void *buf, int size) {
+	running_machine *const machine = emscripten_running_machine;
+	if (!machine)
+		return -1;
+	if (!machine->m_scheduler.can_save())
+		return -2;
+	const int err = int(machine->m_save.read_buffer(buf, size_t(size)));
+	// What the ports read is latched once a frame and was never part of a save state, so a
+	// machine that loads one goes on reading the buttons of the frame it had already reached.
+	// Latching again here, from the keys as they are now, gives the frame about to run the
+	// buttons it had the first time (see mame_set_key).
+	if (err == STATERR_NONE)
+		machine->ioport().relatch_inputs();
+	return err;
+}
+
+// what one call of the browser's main loop does: 1/60 s of emulation and a video update
+void running_machine::emscripten_run_frame() {
+	if (emscripten_running_machine)
+		emscripten_main_loop();
+}
+
+extern "C" {
+EMSCRIPTEN_KEEPALIVE int mame_state_size() { return running_machine::emscripten_state_size(); }
+EMSCRIPTEN_KEEPALIVE int mame_state_save(void *buf, int size) { return running_machine::emscripten_state_save(buf, size); }
+EMSCRIPTEN_KEEPALIVE int mame_state_load(const void *buf, int size) { return running_machine::emscripten_state_load(buf, size); }
+EMSCRIPTEN_KEEPALIVE void mame_run_frame() { running_machine::emscripten_run_frame(); }
+}
+
 #endif /* defined(__EMSCRIPTEN__) */
