+#if defined(__EMSCRIPTEN__)
+#include <emscripten.h>
+
+// See MIN_POLLING_INTERVAL in input_common.h.
+int emscripten_min_polling_interval = 10;
+
+extern "C" EMSCRIPTEN_KEEPALIVE void mame_poll_every_read(int on)
+{
+	emscripten_min_polling_interval = on ? 0 : 10;
+}
+#endif
