--- a/src/osd/modules/input/input_common.h
+++ b/src/osd/modules/input/input_common.h
@@ -415,8 +415,17 @@
 typedef std::chrono::high_resolution_clock clock_type;
 typedef std::chrono::time_point<std::chrono::high_resolution_clock> timepoint_type;
 
+#if defined(__EMSCRIPTEN__)
+// How often input is polled, in milliseconds: MAME's own 10, unless a page that runs frames
+// itself (rollback netplay) asks for every read to poll (mame_poll_every_read), so that a frame's
+// presses count on that frame however fast the frames are run. Only for a page that needs it: a
+// mouse starts its movement again from nothing at each poll, so polling on every read loses it.
+extern int emscripten_min_polling_interval;
+#define MIN_POLLING_INTERVAL emscripten_min_polling_interval
+#else
 // 10 milliseconds polling interval
 #define MIN_POLLING_INTERVAL 10
+#endif
 
 class input_module_base : public input_module
 {
